# Local development only. Use a strong URL-safe password; this value is a placeholder.
POSTGRES_PASSWORD=

# Local Compose only. Production API deployments require Supabase auth settings.
AUTH_ALLOW_ANONYMOUS=
SUPABASE_URL=
SUPABASE_ANON_KEY=
INITIAL_ADMIN_USER_ID=

# Shared nonsecret provider budget scope; choose limits below your account allowance.
# Zero/missing limits disable the corresponding provider; demo remains available.
PROVIDER_QUOTA_SCOPE=
GEMINI_DAILY_CALL_LIMIT=
OLLAMA_DAILY_CALL_LIMIT=

# Leave blank to keep Gemini unavailable. Never use a NEXT_PUBLIC_ prefix for secrets.
GEMINI_API_KEY=
GEMINI_MODEL=

# For Ollama on the Windows host, use http://host.docker.internal:11434.
OLLAMA_ENDPOINT=
OLLAMA_API_KEY=
OLLAMA_MODEL=

OPENAI_API_KEY=